shader_type spatial;
render_mode cull_disabled;

// ВЕТЕР И ЦВЕТ. Всё дерево — одна сетка, один вызов отрисовки, один материал; отличает
// древесину от листвы канал G вершинного цвета.
//
// РАСКАЧКА СЧИТАЕТСЯ В ВЕРШИНАХ, и это единственное разумное место. Двигать деревья на
// процессоре — значит пересобирать тысячи трансформов каждый кадр; двигать вершины на
// видеокарте стоит нескольких инструкций и не касается ни физики, ни памяти.
//
// ВЕТЕР — ЭТО ДВА ДВИЖЕНИЯ, а не одно. Медленный порыв, идущий волной ПО МИРУ, и быстрый
// трепет листвы, у каждого дерева свой. Одна синусоида на всё даёт «дышащий» лес, где
// деревья качаются в такт, — сразу видно, что это не ветер, а анимация.

uniform vec3 wood_low : source_color = vec3(0.19, 0.14, 0.11);
uniform vec3 wood_high : source_color = vec3(0.34, 0.26, 0.19);
uniform vec3 leaf_dark : source_color = vec3(0.10, 0.21, 0.10);
uniform vec3 leaf_light : source_color = vec3(0.30, 0.44, 0.19);

/// СИЛА ВЕТРА. Меняет НЕ ТОЛЬКО амплитуду: в бурю ветер ещё и быстрее, и порывы резче.
/// Одна амплитуда без скорости даёт «медленное качание сильнее», что читается не бурей, а
/// замедленной съёмкой.
uniform float wind : hint_range(0.0, 3.0) = 1.0;
uniform float gust_on : hint_range(0.0, 1.0) = 1.0;
uniform float wind_speed = 1.0;
uniform vec2 wind_dir = vec2(0.86, 0.5);
/// Насколько крона светлеет сверху. Дешёвая замена настоящему затенению кроны: свет всё
/// равно приходит сверху, и низ кроны обязан быть темнее.
uniform float canopy_shade : hint_range(0.0, 1.0) = 0.75;
uniform float tint_spread : hint_range(0.0, 1.0) = 0.55;

varying float v_leaf;
varying float v_tint;
varying float v_up;


void vertex() {
	float sway = COLOR.r;
	v_leaf = COLOR.g;
	v_tint = COLOR.b;

	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	// Фаза дерева приходит из данных экземпляра: без неё все деревья качаются синхронно.
	float phase = INSTANCE_CUSTOM.x * 6.2831853;
	// Скорость растёт с ветром, но СЛАБО. Сила ветра — это прежде всего наклон, а не темп;
	// когда темп рос вровень с амплитудой, буря читалась перемоткой, а не бурей.
	float t = TIME * wind_speed * (0.8 + 0.28 * wind);

	// ПОРЫВ. Волна по миру: аргумент зависит от мировых координат, поэтому по лесу идёт
	// именно волна, а не общее дрожание. Период десятки метров — как настоящий шквал.
	float gust = sin(t * 0.4 + wp.x * 0.035 + wp.z * 0.028) * 0.5 + 0.5;
	// В бурю порыв становится резче: та же волна, поднятая в степень, даёт крутые фронты
	// вместо плавного дыхания.
	gust = pow(gust, mix(1.0, 2.6, clamp(wind - 0.6, 0.0, 1.0)));
	gust = mix(0.35, gust, gust_on);

	// ТРЕПЕТ. Быстрый, мелкий, у листвы вчетверо сильнее, чем у древесины.
	float flut = sin(t * 2.6 + phase * 3.1) * 0.6 + sin(t * 4.3 + phase * 7.7) * 0.4;

	// Квадрат веса — профиль изгиба консоли: комель не двигается вовсе, кончик сильно.
	float bend = sway * sway;

	// НАПРАВЛЕНИЕ ВЕТРА — В МИРОВЫХ ОСЯХ, а не в осях дерева.
	//
	// Здесь был настоящий баг: смещение писалось прямо в `VERTEX.xz`, то есть в ЛОКАЛЬНЫЕ
	// координаты экземпляра, а у каждого дерева свой случайный поворот вокруг Y. Один и тот
	// же вектор ветра становился разным направлением в мире, и лес качался врассыпную —
	// каждое дерево в свою сторону. Выглядело как ветер ровно до тех пор, пока не начнёшь
	// смотреть, КУДА именно гнёт.
	//
	// Столбцы MODEL_MATRIX — это оси экземпляра в мире. Проекции мирового направления на
	// них и дают то же направление, выраженное в осях дерева. Обратная матрица не нужна:
	// поворот с равномерным масштабом обращается транспонированием.
	vec3 dw = normalize(vec3(wind_dir.x, 0.0, wind_dir.y));
	vec2 dl = vec2(dot(dw, normalize(MODEL_MATRIX[0].xyz)),
		dot(dw, normalize(MODEL_MATRIX[2].xyz)));

	// ПОСТОЯННЫЙ НАКЛОН плюс колебание. Именно постоянная составляющая читается силой:
	// в бурю лес СТОИТ наклонённым по ветру, а не просто быстрее машет.
	float lean = wind * wind * 0.22;
	float amp = lean + wind * (0.42 * gust + 0.10 * flut * mix(0.25, 1.0, v_leaf));
	VERTEX.xz += dl * amp * bend;
	// Просадка вниз: ветка, отклонённая вбок, не удлиняется.
	VERTEX.y -= amp * amp * bend * 0.35;

	v_up = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz).y;
}


void fragment() {
	// ПЕРЕВОРОТ НОРМАЛИ У ЗАДНИХ ГРАНЕЙ. При `cull_disabled` изнанка сохраняет нормаль
	// лицевой стороны и освещается наизнанку: у ярусов ели появлялись ярко-зелёные каёмки
	// там, где мы смотрим на юбку снизу. Одна строка, и ни одна геометрия не переделывается.
	// Во фрагменте `NORMAL` уже в осях вида, поэтому её достаточно перевернуть — никакой
	// матрицы не нужно, и `MODELVIEW_MATRIX` там всё равно недоступна.
	float side = FRONT_FACING ? 1.0 : -1.0;
	NORMAL *= side;
	float up = v_up * side;

	vec3 wood = mix(wood_low, wood_high, v_tint);
	vec3 leaf = mix(leaf_dark, leaf_light, clamp(v_tint * tint_spread + 0.25, 0.0, 1.0));
	// Верх кроны светлее низа. Настоящего затенения внутри кроны нет и не будет — это
	// тысячи полупрозрачных пересечений; заменяется одной строкой по нормали.
	leaf *= mix(1.0 - canopy_shade * 0.55, 1.0, clamp(up * 0.5 + 0.5, 0.0, 1.0));
	ALBEDO = mix(wood, leaf, v_leaf);
	ROUGHNESS = mix(0.92, 0.78, v_leaf);
	SPECULAR = 0.15;
}
