class_name StuffKind
extends Resource
## ИЗ ЧЕГО СДЕЛАНО.
##
## Материал — это `Resource`, а не набор чисел на теле: его кладут в `.tres`, крутят в
## инспекторе на живой игре и вешают на любой предмет. В сорок второй пробе «материала» не
## было вовсе — три предмета отличались только цветом и размером.
##
## Две величины, и их постоянно путают:
##
##   ПРОЧНОСТЬ — при каком ударе вообще начнёт ломаться;
##   ВЯЗКОСТЬ  — сколько энергии съедает на каждый квадратный метр новой поверхности скола.
##
## Форму обломков задаёт вторая. Новая поверхность стоит энергии, значит при одном и том же
## ударе вязкий материал даст мало крупных кусков, а хрупкий — много мелких.

## Сколько новой поверхности даёт один кусок, в долях `V^(2/3)`. Подобрано так, чтобы при
## обычном выстреле четыре материала легли в наблюдаемое окно, а не упёрлись в потолок.
const SURFACE := 6.0
## Объём, к которому привязана прочность, м³.
const REFERENCE := 1.0

@export var title := "бетон"
## Дж на квадратный метр новой поверхности. Больше — куски крупнее.
@export var toughness := 5.5
## Порог разрушения, Дж на м² сечения. Больше — надо бить сильнее.
@export var strength := 40.0
## Насколько мелкий кусок прочнее крупного. Ноль — размер не важен, и дробление никогда не
## затухает. У стекла много (мало дефектов в мелком осколке), у бетона мало.
@export_range(0.0, 0.6) var flaw := 0.25
## УЗОР ЛОМАНИЯ. Вдоль какой оси куски вытянуты: (1,1,1) — щебень, (5,1,1) — щепа вдоль
## волокна, (1,0.2,1) — плитняк. Растяжение метрики, а не форма ячейки: рез остаётся
## Вороным и куски по-прежнему складываются в целое.
@export var grain := Vector3.ONE
@export var density := 2400.0
## САМЫЙ МЕЛКИЙ ОСКОЛОК, м³. Мельче этого материал не дробится: у бетона это щебёнка, у
## стекла — крошка. Именно он, а не наша ручка глубины, останавливает повторный скол.
@export var grit := 0.002
## КАК ЭНЕРГИЯ ДОХОДИТ ДО РАСКОЛА. Выключено — по сечению предмета: грубо, зато терпит любую
## калибровку, и на этом стоит игровой пресет. Включено — участвует только материал, который
## снаряд РЕАЛЬНО ЗАДЕЛ: пуля отдаёт свои джоули в десятисантиметровую воронку, а не всему
## блоку сразу.
##
## Разница видна только на настоящих величинах. С паспортной вязкостью бетона и настоящей
## дульной энергией правило по сечению даёт чушь: винтовочная пуля крошит двухтонный блок на
## двадцать один кусок. С воронкой она его даже не пробивает — что и происходит на стрельбище.
@export var crater_bound := false

@export_group("Look")
@export var body_look: StandardMaterial3D
@export var shard_look: StandardMaterial3D
@export var rubble: PhysicsMaterial


## НА СКОЛЬКО КУСКОВ. Дробление на N частей создаёт новой поверхности примерно
## `N^(1/3) · V^(2/3)`, и вся она оплачивается энергией удара:
##
##     E = вязкость · SURFACE · N^(1/3) · V^(2/3)   →   N = (E / (вязкость · площадь))³
##
## Куб — не описка. Именно из-за него энергия оказывается очень резкой ручкой.
func pieces(energy: float, volume: float, cap: int) -> int:
	if volume < grit * 2.0:
		return 0
	var area := SURFACE * pow(maxf(volume, 1e-6), 2.0 / 3.0)
	var count := energy / maxf(toughness * area, 1e-6)
	# Потолок двойной: наш бюджет тел и собственная зернистость материала. Без второго
	# мелкий осколок «раскалывался» на ячейки ниже порога отсечки и ИСЧЕЗАЛ вместе с массой.
	return clampi(int(pow(count, 3.0)), 2, mini(cap, int(volume / grit)))


## СКОЛЬКО ЭНЕРГИИ ПРЕДМЕТ РЕАЛЬНО ПОГЛОТИТ. Пуля, попавшая в мелкий осколок, пробивает его
## насквозь и уносит энергию дальше; в толстую колонну она уходит целиком. Поглощение растёт
## с сечением, то есть как `V^(2/3)`.
##
## Отсюда неожиданно чистое следствие: в сравнении «поглощено против порога» множитель
## `V^(2/3)` сокращается, и **сломается ли предмет, зависит только от прочности и
## дефектности, а не от размера.** Размер входит лишь через дефектность — и именно поэтому
## дробление затухает: осколку нужен удар сильнее, чем целому предмету.
func soak(energy: float, volume: float, bite := 0.0) -> float:
	if crater_bound:
		return energy * clampf(bite / maxf(volume, 1e-9), 0.0, 1.0)
	return energy * clampf(pow(maxf(volume, 1e-6) / REFERENCE, 2.0 / 3.0), 0.02, 1.0)


## ПОРОГ. Крупному куску расколоться легче: в нём больше дефектов, а трещина начинается с
## дефекта. По той же причине стеклянное волокно прочнее стеклянного стержня — и по этой же
## причине дробление затухает само, а не уходит в бесконечность.
func threshold(volume: float) -> float:
	var sized := maxf(volume, 1e-6)
	return strength * pow(sized, 2.0 / 3.0) * pow(REFERENCE / sized, flaw)
