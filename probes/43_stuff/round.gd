class_name StuffRound
extends Resource
## ЧЕМ БЬЮТ.
##
## У снаряда две независимые величины, и путать их так же дорого, как прочность с вязкостью:
##
##   ЭНЕРГИЯ решает, НА СКОЛЬКО КУСКОВ разлетится материал;
##   ИМПУЛЬС решает, КАК ДАЛЕКО эти куски улетят.
##
## Винтовочная пуля лёгкая и быстрая: `E = mv²/2` растёт со скоростью в квадрате, а импульс
## `p = mv` — линейно. Отсюда у неё энергии много, а импульса почти нет: она колет и не
## толкает. Ракета тяжёлая и медленная — импульса на два порядка больше при сравнимой энергии,
## и куски разлетаются. До этой пробы у меня была одна ручка «энергия», которой я двигал и то
## и другое, поэтому бетон крошился, но никуда не летел.
##
## Третья величина — КАЛИБР. Он не про силу вовсе, а про РАЗМЕР ВОРОНКИ: где материал сядет
## мелко, а где отвалится крупными кусками.

## Объём шара единичного радиуса, 4π/3.
const SPHERE := 4.18879

@export var title := "винтовочный"
## Диаметр, м.
@export var calibre := 0.01
## Дж — сколько будет кусков.
@export var energy := 60.0
## кг·м/с — как далеко они улетят.
@export var momentum := 12.0
## Во сколько раз воронка шире самого снаряда. У кумулятивного заряда шире, чем у болванки.
@export var crater_width := 3.0
## РАДИУС ПОРАЖЕНИЯ, м. Ноль — снаряд бьёт в точку, куда попал. Больше нуля — достаёт всё
## вокруг, слабея к краю: так работает фугас, и только так одним ударом забирают целый ряд
## колонн. Без этого «мощнее» означало лишь «мельче крошит одну колонну».
@export var blast := 0.0


## Радиус воронки: в нём садится крошка, за ним материал отходит крупно.
func crater() -> float:
	return calibre * crater_width


## Объём воронки — сколько материала снаряд вообще задевает.
func bite() -> float:
	var radius := crater()
	return SPHERE * radius * radius * radius
