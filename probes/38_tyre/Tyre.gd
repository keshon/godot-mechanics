extends RefCounted
class_name TyreLaw
## ШИНА КАК ЗАКОН СИЛЫ.
##
## В соседней пробе шина была обрезкой: боковая сила линейна по углу увода, продольная равна
## тому, что попросил мотор, а круг трения наведён подрезанием вектора. Ездит убедительно и
## врёт в одном месте — **у колеса нет собственной угловой скорости**. Значит нет ни
## пробуксовки, ни блокировки, ни разницы между дифференциалами.
##
## Здесь угловая скорость есть, и из неё берутся ДВА скольжения:
##
##   продольное  κ = (ωR − v_x) / |v_x|   — колесо крутится быстрее или медленнее хода
##   боковое     α = atan(−v_y / |v_x|)   — колесо катится не туда, куда смотрит
##
## Обе силы приходят из ОДНОГО закона, а не считаются порознь и режутся потом. Для этого
## скольжения сводятся в один вектор, закон даёт его длину, а направление берётся против
## вектора: круг трения выпадает сам, а не навязывается.
##
## Три модели на выбор, чтобы разницу можно было пощупать рулём, а не прочитать:
## обрезка (как в 37), щёточная (физическая) и «волшебная формула» Пацейки (подгонка).

enum Model {CLAMP, BRUSH, PACEJKA}

## Ниже этой скорости знаменатель в скольжении подменяется константой. Без этого на
## околонуле любое движение даёт бесконечное скольжение и машину выстреливает с места.
const V_EPS := 1.5


## СВЕДЕНИЕ ДВУХ СКОЛЬЖЕНИЙ В ОДИН ВЕКТОР.
##
## Деление на (1 + κ) — не косметика: при κ = −1 колесо заблокировано, пятно контакта скользит
## целиком, и боковое скольжение обязано уйти в бесконечность вместе с продольным. Именно эта
## строка объясняет, почему на заблокированных колёсах машина едет прямо, как ни выворачивай
## руль: заблокированное колесо не имеет бокового сцепления вообще.
static func slip_vector(kappa: float, alpha: float) -> Vector2:
	var denom := maxf(1.0 + kappa, 0.12)
	return Vector2(kappa / denom, tan(alpha) / denom)


## НАГРУЗОЧНАЯ ЧУВСТВИТЕЛЬНОСТЬ: коэффициент сцепления ПАДАЕТ с ростом нагрузки.
##
## Одна строка, и она переворачивает всю настройку шасси. Пока μ постоянна, суммарный запас
## равен μ·mg независимо от распределения веса: сколько потеряло разгруженное колесо, ровно
## столько приобрело нагруженное, и перенос веса не отнимает ничего. С падающей μ перенос
## веса УМЕНЬШАЕТ общий запас — и тогда жёсткость оси начинает решать, какая ось сорвётся
## первой. Вся наука о балансе машины живёт в этом наклоне.
static func mu_at(mu0: float, fz: float, fz_ref: float, sensitivity: float) -> float:
	if fz <= 0.0:
		return 0.0
	var excess := fz / maxf(fz_ref, 1.0) - 1.0
	return maxf(mu0 * (1.0 - sensitivity * excess), 0.1)


## СИЛА В ОСЯХ КОЛЕСА: x вдоль качения, y вбок. `stiffness` — наклон кривой у нуля, в
## ньютонах на единицу скольжения; `mu * fz` — потолок.
##
## ЗНАК СОНАПРАВЛЕН СО СКОЛЬЖЕНИЕМ, а не противоположен ему, и это не описка. κ считается
## как (ωR − v): положительное значит, что поверхность шины бежит вперёд быстрее земли,
## шина толкает землю назад, а земля толкает машину ВПЕРЁД. Тот же знак и у бокового:
## α уже определён с минусом от боковой скорости. Стоял минус — шина толкала ПО
## скольжению, петля пошла вразнос, колёса раскрутились до пяти тысяч рад/с, а машина
## осталась стоять: передние и задние силы взаимно погасились.
static func force(model: Model, kappa: float, alpha: float, mu: float, fz: float,
		stiffness: float, shape: float, curvature: float) -> Vector2:
	if fz <= 1.0:
		return Vector2.ZERO
	var s := slip_vector(kappa, alpha)
	var peak := mu * fz

	if model == Model.CLAMP:
		# КАК В 37-Й: две оси считаются порознь и режутся по кругу постом. Оставлено ради
		# честного сравнения — разница с двумя другими и есть предмет пробы.
		var f := Vector2(clampf(s.x * stiffness, -peak, peak),
			clampf(s.y * stiffness, -peak, peak))
		if f.length() > peak:
			f = f.normalized() * peak
		return f

	var mag := s.length()
	if mag < 1e-5:
		return Vector2.ZERO
	var value := 0.0

	if model == Model.BRUSH:
		# ЩЁТОЧНАЯ МОДЕЛЬ. Пятно контакта — ряд упругих ворсинок: у входа они прилипли и
		# гнутся, дальше по пятну натяжение превышает трение и они срываются. Доля
		# сцепившейся части падает с ростом скольжения, отсюда форма кривой. Три параметра
		# и ни одного подогнанного коэффициента — всё выводится из геометрии пятна.
		var z := stiffness * mag / (3.0 * peak)
		value = peak if z >= 1.0 else 3.0 * peak * (z - z * z + z * z * z / 3.0)
	else:
		# ВОЛШЕБНАЯ ФОРМУЛА ПАЦЕЙКИ. Не выводится ни из чего: это кривая, которую подбирают
		# под замеры на стенде. Зато она умеет то, чего щёточная не умеет, — ПАДАТЬ после
		# пика. Настоящая шина держит максимум в узком окне скольжения, а дальше отдаёт
		# процентов десять-пятнадцать, и именно этот спад делает срыв срывом.
		var b := stiffness / (shape * peak)
		var bx := b * mag
		value = peak * sin(shape * atan(bx - curvature * (bx - atan(bx))))

	return s / mag * value


## Момент от продольной силы, который тормозит или раскручивает колесо. Отдельной функции
## он не заслуживает, но имя объясняет знак: сила, толкающая машину вперёд, ЗАМЕДЛЯЕТ колесо.
static func reaction_torque(fx: float, radius: float) -> float:
	return -fx * radius


## Скольжения из скоростей в пятне контакта и угловой скорости колеса.
static func slips(omega: float, radius: float, v_long: float, v_lat: float) -> Vector2:
	var denom := maxf(absf(v_long), V_EPS)
	return Vector2((omega * radius - v_long) / denom, atan2(-v_lat, denom))
