class_name TyreLaw
extends RefCounted
## ШИНА КАК ЗАКОН СИЛЫ.
##
## В 37-й шина была обрезкой: боковая сила линейна по углу увода, продольная равна тому,
## что попросил мотор, а круг трения наведён подрезанием вектора. Ездит убедительно и врёт
## в одном месте — **у колеса нет собственной угловой скорости**. Значит нет ни
## пробуксовки, ни блокировки, ни разницы между дифференциалами.
##
## Здесь угловая скорость есть, и из неё берутся ДВА скольжения:
##
##   продольное  κ = (ωR − v_x) / |v_x|   — колесо крутится быстрее или медленнее хода
##   боковое     α = atan(−v_y / |v_x|)   — колесо катится не туда, куда смотрит
##
## Обе силы приходят из ОДНОГО закона, а не считаются порознь и режутся потом. Для этого
## скольжения сводятся в один вектор, закон даёт его длину, а направление берётся против
## вектора: круг трения выпадает сам, а не навязывается.
##
## Три модели на выбор, чтобы разницу можно было пощупать рулём, а не прочитать: обрезка
## (как в 37), щёточная (физическая) и «волшебная формула» Пацейки (подгонка).

enum Model {
	CLAMP,
	BRUSH,
	PACEJKA,
}

## Ниже этой скорости знаменатель в скольжении подменяется константой, м/с. Без этого на
## околонуле любое движение даёт бесконечное скольжение и машину выстреливает с места.
const V_EPS := 1.5


## СВЕДЕНИЕ ДВУХ СКОЛЬЖЕНИЙ В ОДИН ВЕКТОР.
##
## Деление на (1 + κ) — не косметика: при κ = −1 колесо заблокировано, пятно контакта
## скользит целиком, и боковое скольжение обязано уйти в бесконечность вместе с
## продольным. Именно эта строка объясняет, почему на заблокированных колёсах машина едет
## прямо, как ни выворачивай руль.
static func slip_vector(kappa: float, alpha: float) -> Vector2:
	var denominator := maxf(1.0 + kappa, 0.12)
	return Vector2(kappa / denominator, tan(alpha) / denominator)


## НАГРУЗОЧНАЯ ЧУВСТВИТЕЛЬНОСТЬ: коэффициент сцепления ПАДАЕТ с ростом нагрузки.
##
## Одна строка, и она переворачивает всю настройку шасси. Пока μ постоянна, суммарный
## запас равен μ·mg независимо от распределения веса: сколько потеряло разгруженное
## колесо, ровно столько приобрело нагруженное, и перенос веса не отнимает ничего. С
## падающей μ перенос веса УМЕНЬШАЕТ общий запас — и тогда жёсткость оси начинает решать,
## какая ось сорвётся первой. Вся наука о балансе машины живёт в этом наклоне.
static func mu_at(mu0: float, load: float, load_ref: float, sensitivity: float) -> float:
	if load <= 0.0:
		return 0.0
	var excess := load / maxf(load_ref, 1.0) - 1.0
	return maxf(mu0 * (1.0 - sensitivity * excess), 0.1)


## Скольжения из скоростей в пятне контакта и угловой скорости колеса.
static func slips(
		omega: float, radius: float, speed_along: float, speed_across: float) -> Vector2:
	var denominator := maxf(absf(speed_along), V_EPS)
	return Vector2(
			(omega * radius - speed_along) / denominator,
			atan2(-speed_across, denominator))


## СИЛА В ОСЯХ КОЛЕСА: x вдоль качения, y вбок. `stiffness` — наклон кривой у нуля, в
## ньютонах на единицу скольжения; `mu * load` — потолок.
##
## ЗНАК СОНАПРАВЛЕН СО СКОЛЬЖЕНИЕМ, а не противоположен ему, и это не описка. κ считается
## как (ωR − v): положительное значит, что поверхность шины бежит вперёд быстрее земли,
## шина толкает землю назад, а земля толкает машину ВПЕРЁД. Тот же знак и у бокового: α
## уже определён с минусом от боковой скорости. С минусом шина толкает ПО скольжению,
## петля идёт вразнос, колёса раскручиваются до пяти тысяч рад/с, а машина стоит:
## передние и задние силы взаимно гасятся.
static func force(
		model: Model,
		kappa: float,
		alpha: float,
		mu: float,
		load: float,
		stiffness: float,
		shape: float,
		curvature: float) -> Vector2:
	if load <= 1.0:
		return Vector2.ZERO
	var slip := slip_vector(kappa, alpha)
	var peak := mu * load

	if model == Model.CLAMP:
		# КАК В 37-Й: две оси считаются порознь и режутся по кругу постом. Оставлено ради
		# честного сравнения — разница с двумя другими и есть предмет пробы.
		var clamped := Vector2(
				clampf(slip.x * stiffness, -peak, peak),
				clampf(slip.y * stiffness, -peak, peak))
		if clamped.length() > peak:
			clamped = clamped.normalized() * peak
		return clamped

	var magnitude := slip.length()
	if magnitude < 1e-5:
		return Vector2.ZERO
	var value := 0.0

	if model == Model.BRUSH:
		# ЩЁТОЧНАЯ МОДЕЛЬ. Пятно контакта — ряд упругих ворсинок: у входа они прилипли и
		# гнутся, дальше по пятну натяжение превышает трение и они срываются. Доля
		# сцепившейся части падает с ростом скольжения, отсюда форма кривой. Три параметра
		# и ни одного подогнанного коэффициента — всё выводится из геометрии пятна.
		var reach := stiffness * magnitude / (3.0 * peak)
		if reach >= 1.0:
			value = peak
		else:
			value = 3.0 * peak * (reach - reach * reach + reach * reach * reach / 3.0)
	else:
		# ВОЛШЕБНАЯ ФОРМУЛА ПАЦЕЙКИ. Не выводится ни из чего: это кривая, которую
		# подбирают под замеры на стенде. Зато она умеет то, чего щёточная не умеет, —
		# ПАДАТЬ после пика. Настоящая шина держит максимум в узком окне скольжения, а
		# дальше отдаёт процентов десять-пятнадцать, и именно этот спад делает срыв срывом.
		var slope := stiffness / (shape * peak)
		var scaled := slope * magnitude
		value = peak * sin(shape * atan(scaled - curvature * (scaled - atan(scaled))))

	return slip / magnitude * value


## Момент от продольной силы, который тормозит или раскручивает колесо. Отдельной функции
## он не заслуживает, но имя объясняет знак: сила, толкающая машину вперёд, ЗАМЕДЛЯЕТ
## колесо.
static func reaction_torque(force_along: float, radius: float) -> float:
	return -force_along * radius
